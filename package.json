{
  "name": "rate-slayer-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Rate Slayer workspace with agent runtime and dashboard",
  "workspaces": [
    "agent",
    "dashboard"
  ],
  "scripts": {
    "agent": "cd agent && node index.js",
    "dashboard": "cd dashboard && npm run dev",
    "dev": "concurrently \"npm run agent\" \"npm run dashboard\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
